{
  "name": "rf4-navigator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "https-proxy-agent": "9.1.0",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
